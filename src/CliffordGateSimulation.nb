       RowBox[{"AppendTo", "[", 
        RowBox[{"result", ",", " ", "state"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Running", " ", "simulation"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Developing", " ", "random", " ", "Brickwork", " ", "every", " ", 
          "step"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"firststepgates", " ", "=", " ", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"n", "=", "1"}], ",", " ", 
            RowBox[{"n", "\[LessEqual]", 
             RowBox[{"qubitnum", "/", "2"}]}], ",", " ", 
            RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"oneortwo", " ", "=", " ", 
              RowBox[{"RandomChoice", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"1", "-", "twogatelikelihood"}], ",", 
                  "twogatelikelihood"}], "}"}], "->", " ", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", " ", "[", 
              RowBox[{
               RowBox[{"oneortwo", " ", "==", " ", "1"}], ",", 
               RowBox[{"gate", "=", " ", 
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{
                  RowBox[{"RandomChoice", "[", "onegatelist", "]"}], ",", 
                  RowBox[{"RandomChoice", "[", "onegatelist", "]"}]}], 
                 "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"oneortwo", " ", "==", "2"}], ",", " ", 
               RowBox[{"gate", " ", "=", " ", 
                RowBox[{"RandomChoice", "[", "twogatelist", "]"}]}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"firststepgates", ",", " ", "gate"}], "]"}]}]}], "]"}], 
          ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"secondstepgates", " ", "=", " ", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"n", "=", "1"}], ",", " ", 
            RowBox[{"n", "\[LessEqual]", 
             RowBox[{"qubitnum", "/", "2"}]}], ",", " ", 
            RowBox[{"n", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"oneortwo", " ", "=", " ", 
              RowBox[{"RandomChoice", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"1", "-", "twogatelikelihood"}], ",", 
                  "twogatelikelihood"}], "}"}], "->", " ", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", " ", "[", 
              RowBox[{
               RowBox[{"oneortwo", " ", "==", " ", "1"}], ",", " ", 
               RowBox[{"gate", "=", " ", 
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{
                  RowBox[{"RandomChoice", "[", "onegatelist", "]"}], ",", 
                  RowBox[{"RandomChoice", "[", "onegatelist", "]"}]}], 
                 "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"oneortwo", " ", "==", "2"}], ",", " ", 
               RowBox[{"gate", " ", "=", " ", 
                RowBox[{"RandomChoice", "[", "twogatelist", "]"}]}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"secondstepgates", ",", " ", "gate"}], "]"}]}]}], "]"}],
           ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Applying", " ", "first", " ", "layer"}], ",", " ", 
            RowBox[{"even", " ", "pairs"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"newpair1", " ", "=", " ", 
              RowBox[{"which2PauliString", "[", 
               RowBox[{
                RowBox[{"firststepgates", "[", 
                 RowBox[{"[", 
                  RowBox[{"Quotient", "[", 
                   RowBox[{
                    RowBox[{"m", "+", "1"}], ",", "2"}], "]"}], "]"}], "]"}], 
                ",", 
                RowBox[{"state", "[", 
                 RowBox[{"[", "m", "]"}], "]"}], ",", 
                RowBox[{"state", "[", 
                 RowBox[{"[", 
                  RowBox[{"m", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";", "\n",
              "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"state", "[", 
               RowBox[{"[", "m", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"newpair1", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "*", 
               RowBox[{"newpair1", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"state", "[", 
               RowBox[{"[", 
                RowBox[{"m", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"newpair1", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "*", 
               RowBox[{"newpair1", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], ";"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"m", ",", "1", ",", 
              RowBox[{
               RowBox[{"Length", "[", "state", "]"}], "-", "1"}], ",", "2"}], 
             "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"result", ",", "state"}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Applying", " ", "second", " ", "layer"}], ",", " ", 
            RowBox[{"odd", " ", "pairs"}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"newpair2", " ", "=", " ", 
              RowBox[{"which2PauliString", "[", 
               RowBox[{
                RowBox[{"secondstepgates", "[", 
                 RowBox[{"[", 
                  RowBox[{"Quotient", "[", 
                   RowBox[{"k", ",", "2"}], "]"}], "]"}], "]"}], ",", 
                RowBox[{"state", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", 
                RowBox[{"state", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "+", "1"}], "]"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"state", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"newpair2", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "*", 
               RowBox[{"newpair2", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"state", "[", 
               RowBox[{"[", 
                RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"newpair2", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "*", 
               RowBox[{"newpair2", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], ";"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"k", ",", "2", ",", 
              RowBox[{
               RowBox[{"Length", "[", "state", "]"}], "-", "1"}], ",", "2"}], 
             "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Wrapping", " ", "last", " ", "qubit", " ", "to", " ", "first", 
            " ", "qubit", " ", "with", " ", "odd", " ", "gates"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"newpair3", "=", 
           RowBox[{"which2PauliString", "[", 
            RowBox[{
             RowBox[{"Last", "[", "secondstepgates", "]"}], ",", 
             RowBox[{"Last", "[", "state", "]"}], ",", 
             RowBox[{"First", "[", "state", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"state", "[", 
            RowBox[{"[", "qubitnum", "]"}], "]"}], " ", "=", " ", 
           RowBox[{
            RowBox[{"newpair3", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "*", 
            RowBox[{"newpair3", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"state", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{"newpair3", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "*", 
            RowBox[{"newpair3", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"result", ",", "state"}], "]"}], ";"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"l", ",", "1", ",", "layer"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", "Plotting", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Labeled", "[", 
        RowBox[{
         RowBox[{"ArrayPlot", "[", 
          RowBox[{"result", ",", "\[IndentingNewLine]", 
           RowBox[{"Frame", "->", "False"}], ",", "\[IndentingNewLine]", " ", 
           
           RowBox[{"Axes", "->", "True"}], ",", " ", "\[IndentingNewLine]", 
           RowBox[{"AxesLabel", " ", "->", 
            RowBox[{"{", " ", 
             RowBox[{
             "\"\<Pauli String Position\>\"", ",", "\"\<Circuit Layer\>\""}], 
             "}"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"ColorRules", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "->", "Blue"}], ",", 
              RowBox[{
               RowBox[{"-", "1"}], "->", " ", "Blue"}], ",", " ", 
              RowBox[{"\[ImaginaryI]", "->", " ", "Blue"}], ",", " ", 
              RowBox[{
               RowBox[{"-", "\[ImaginaryI]"}], "->", " ", "Blue"}], ",", " ", 
              
              RowBox[{"2", "->", "Orange"}], ",", 
              RowBox[{
               RowBox[{"-", "2"}], "->", "Orange"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "2"}], "\[ImaginaryI]"}], " ", "->", " ", 
               "Orange"}], ",", " ", 
              RowBox[{
               RowBox[{"2", "\[ImaginaryI]"}], "->", "Orange"}], ",", 
              RowBox[{"3", "->", "Green"}], ",", 
              RowBox[{
               RowBox[{"-", "3"}], "->", "Green"}], ",", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "3"}], "\[ImaginaryI]"}], "->", "Green"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"3", "\[ImaginaryI]"}], "->", " ", "Green"}], ",", " ", 
              RowBox[{"4", "->", "Black"}], ",", 
              RowBox[{
               RowBox[{"-", "4"}], "->", "Black"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "4"}], "\[ImaginaryI]"}], "->", "Black"}], ",", 
              " ", 
              RowBox[{
               RowBox[{"4", "\[ImaginaryI]"}], "->", "Black"}]}], "}"}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"DataReversed", "->", 
            RowBox[{"{", 
             RowBox[{"True", ",", " ", "False"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"SwatchLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Blue", ",", "Orange", ",", "Green", ",", "Black"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\"", ",", 
             "\"\<I\>\""}], "}"}]}], "]"}], ",", "Right"}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
